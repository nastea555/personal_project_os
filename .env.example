# Скопируйте в .env и заполните. Файл .env не коммитится.

# PostgreSQL (docker-compose и backend)
POSTGRES_DB=lifehub
POSTGRES_USER=lifehub
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# Backend
SPRING_PROFILES_ACTIVE=local
BACKEND_PORT=8080
DB_URL=jdbc:postgresql://localhost:5432/lifehub

# Frontend
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Voice Inbox / AI (Этап 3). Поставщик заменяемый; ключи только здесь.
AI_PROVIDER=none
AI_API_KEY=
SPEECH_PROVIDER=browser
